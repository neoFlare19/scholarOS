services:
  backend:
    build:
      context: .
      dockerfile: docker/backend/Dockerfile
    container_name: scholaros-backend
    working_dir: /var/www
    ports:
      - "8000:8000"
    volumes:
      - ./backend:/var/www
    environment:
      APP_ENV: local
      APP_DEBUG: "true"
      DB_CONNECTION: mysql
      DB_HOST: mysql
      DB_PORT: 3306
      DB_DATABASE: scholaros
      DB_USERNAME: scholaros
      DB_PASSWORD: scholaros_password
    networks:
      - scholaros

  frontend:
    build:
      context: .
      dockerfile: docker/frontend/Dockerfile
    container_name: scholaros-frontend
    working_dir: /app
    ports:
      - "5173:5173"
    volumes:
      - ./frontend:/app
      - frontend_node_modules:/app/node_modules
    environment:
      VITE_API_URL: http://localhost:8000
    depends_on:
      - backend
    networks:
      - scholaros

  mysql:
    image: mysql:8.4
    container_name: scholaros-mysql
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: scholaros
      MYSQL_USER: scholaros
      MYSQL_PASSWORD: scholaros_password
      MYSQL_ROOT_PASSWORD: root_password
    ports:
      - "3307:3306"
    volumes:
      - mysql_data:/var/lib/mysql
    healthcheck:
      test:
        [
          "CMD",
          "mysqladmin",
          "ping",
          "-h",
          "localhost",
          "-u",
          "scholaros",
          "-pscholaros_password"
        ]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - scholaros

volumes:
  mysql_data:
  frontend_node_modules:

networks:
  scholaros:
    driver: bridge